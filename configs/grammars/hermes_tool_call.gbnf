# GBNF Grammar for Nous Hermes tool calling format (minified JSON, no whitespace)
# Enforces `<tool_call>{"name": "...", "arguments": {...}}</tool_call>`

root ::= toolcall

toolcall ::= "<tool_call>" jsonobject "</tool_call>"

jsonobject ::= "{" "\"name\"" ":" string "," "\"arguments\"" ":" jsonvalueobject "}"

jsonvalueobject ::= "{" (pair ("," pair)*)? "}"
pair ::= string ":" jsonvalue
jsonvalue ::= jsonvalueobject | jsonarray | string | number | "true" | "false" | "null"
jsonarray ::= "[" (jsonvalue ("," jsonvalue)*)? "]"

string ::= "\"" [^"\\]* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
