# Generic JSON object grammar — fallback for structured output requests

root ::= jsonvalueobject

jsonvalueobject ::= "{" ws (pair (ws "," ws pair)*)? ws "}"
pair ::= string ws ":" ws jsonvalue
jsonvalue ::= jsonvalueobject | jsonarray | string | number | "true" | "false" | "null"
jsonarray ::= "[" ws (jsonvalue (ws "," ws jsonvalue)*)? ws "]"

string ::= "\"" ([^"\\] | "\\" .)* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
ws ::= [ \t\n\r]*
